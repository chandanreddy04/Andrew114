# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development

# docker-compose sets these for you; change them when running without Docker.
DATABASE_URL=postgresql+psycopg://reached:reached@localhost:5432/reached
REDIS_URL=redis://localhost:6379/0

# A long random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# ----- Texting -----
# console = print texts in the server log (no Twilio needed); twilio = real texts
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# While Twilio is on a TRIAL account, set a Twilio sample template name
# (e.g. sms_account_alerts) so alert texts still arrive. Clear it after
# upgrading Twilio; no code change needed.
TWILIO_TRIAL_TEMPLATE=
# Optional: a Twilio Verify service (VA...) to send login codes.
TWILIO_VERIFY_SERVICE_SID=

# Test numbers with fixed login codes; they are never texted.
TEST_PHONE_NUMBERS=+15550001111=123456

# ----- Errors -----
BUGSNAG_API_KEY=

# Browsers allowed to call the API (comma-separated). * = any.
CORS_ORIGINS=*

# ----- Address search (Start Session's "Where are you going?") -----
# Photon (free OpenStreetMap search, no key). Point at your own Photon server
# for heavy use.
PLACES_URL=https://photon.komoot.io/api/
